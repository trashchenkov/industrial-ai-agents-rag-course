# ──────────────────────────────────────────────
# GigaChat API
# ──────────────────────────────────────────────
# Base64(client_id:client_secret), см. https://developers.sber.ru/studio
GIGACHAT_CREDENTIALS=your_base64_credentials_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# ──────────────────────────────────────────────
# Models
# ──────────────────────────────────────────────
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_EMBEDDINGS_MODEL=EmbeddingsGigaR

# ──────────────────────────────────────────────
# Generated indexes
# ──────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db

# ──────────────────────────────────────────────
# Online sources
# ──────────────────────────────────────────────
SOURCE_FETCH_TIMEOUT=30

# ──────────────────────────────────────────────
# Phoenix observability for notebooks 02+
# ──────────────────────────────────────────────
PHOENIX_WORKING_DIR=./.phoenix
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317
PHOENIX_PROJECT_NAME_00=topic7-rag-00
PHOENIX_PROJECT_NAME_02=topic7-rag-02
PHOENIX_PROJECT_NAME_03=topic7-rag-03
